# ===== Service =====
HOST=127.0.0.1
PORT=5882

# ===== IP Center =====
CENTER_URL=http://127.0.0.1:6969
MEMBER_ID=1235MEM
PIN=1230
PASSWORD=123pass
SIGN_PREFIX=OtomaX

# ===== API auth =====
# Operasional /api/ping, /api/balance, /api/ticket-mbal.
# /api/transaction memakai kredensial client (client_secret + PIN + keys).
AUVYN_SECRET=change-me-to-a-long-random-string

# ===== Admin auth =====
ADMIN_SECRET=admin_secret_xxxx
ADMIN_PIN=admin_pin_xxxx
ADMIN_KEYS=admin_keys_xxxx

# ===== Storage =====
DATA_DIR=./data
# DB_PATH=./data/auvyn.db

# ===== Legacy callbacks (optional) =====
# CALLBACK_URL=https://worker.example.com/auvyn/callback
# CALLBACK_SECRET=callback-secret
# CALLBACK_TARGETS=[{"name":"worker","url":"https://worker.example.com/cb","secret":"s"}]

MANAGED_WEBHOOKS_ENABLED=true
CALLBACK_TIMEOUT_MS=15000
DELIVERY_MAX_ATTEMPTS=6
WEBHOOK_BACKOFF=1m,5m,30m,2h,6h,24h

# ===== Provider report security =====
# Simpan IP/CIDR egress IP Center, pisahkan koma.
REPORT_ALLOW_IPS=
# Opsional; provider mungkin tidak bisa mengirimnya.
REPORT_TOKEN=
# /report wajib punya minimal satu guard. Set true hanya untuk development.
ALLOW_INSECURE_REPORT=false
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# ===== Limits =====
BALANCE_LOW_LIMIT=50000

# ===== Bebas nominal products =====
EWALLET_BEBAS_PRODUCTS=
EWALLET_BEBAS_QTY_IS_NOMINAL=true
EWALLET_BEBAS_UNIT=1000
SIGN_INCLUDE_NOMINAL=false

# ===== Webhook URL policy =====
ALLOW_INSECURE_WEBHOOKS=false
ALLOW_PRIVATE_WEBHOOKS=false

# ===== Telegram (optional) =====
TG_SUCCESS_BOT_TOKEN=
TG_SUCCESS_CHAT_ID=
TG_PENDING_BOT_TOKEN=
TG_PENDING_CHAT_ID=
TG_FAILED_BOT_TOKEN=
TG_FAILED_CHAT_ID=
TG_SYSTEM_BOT_TOKEN=
TG_SYSTEM_CHAT_ID=
# Opsional untuk grup Telegram dengan Topics/forum.
# Isi message_thread_id tiap topik; kosongkan untuk chat private/General.
TG_SUCCESS_THREAD_ID=
TG_PENDING_THREAD_ID=
TG_FAILED_THREAD_ID=
TG_SYSTEM_THREAD_ID=
# Topic khusus alert saldo; fallback ke TG_SYSTEM_THREAD_ID bila kosong.
TG_BALANCE_THREAD_ID=

# ===== Telegram admin bot (optional) =====
# Bot khusus admin. Gunakan token bot terpisah dari bot notifikasi.
# Hanya private chat ID yang menerima perintah; isi dari @userinfobot.
TG_ADMIN_BOT_TOKEN=
TG_ADMIN_CHAT_IDS=
# Untuk development/fake API; production default https://api.telegram.org
# TG_ADMIN_API_BASE=https://api.telegram.org

# ===== Logging & retention =====
LOG_LEVEL=info
ACCESS_LOG=true
# 0 = jangan prune otomatis. Transaksi tidak pernah dihapus.
RETENTION_DAYS=365
# Cek token/chat Telegram saat start dan log kalau salah konfigurasi.
TELEGRAM_SELFCHECK=true
